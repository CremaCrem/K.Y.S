{
  "name": "kys",
  "version": "0.2.2",
  "private": true,
  "description": "Keep Yourself Save Password Manager",
  "main": "main.js",
  "homepage": ".",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "cross-env BROWSER=none ELECTRON_START_URL=http://localhost:3000 concurrently \"npm run react-start\" \"npm run electron-wait\"",
    "react-start": "react-scripts start",
    "electron-wait": "wait-on http://localhost:3000 && electron .",
    "electron-dev": "electron .",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "package": "electron-builder --win"
  },
  "build": {
    "extends": null,
    "appId": "com.cremacrem.kys",
    "productName": "KYS",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/KYS.ico",
      "sign": null
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "wait-on": "^8.0.1"
  }
}
