{
  "name": "kys",
  "version": "2.1.0",
  "private": true,
  "description": "Keep Yourself Safe Password Manager",
  "main": "main.js",
  "homepage": ".",
  "scripts": {
    "start": "cross-env BROWSER=none ELECTRON_START_URL=http://localhost:3000 concurrently \"npm run react-start\" \"npm run electron-wait\"",
    "react-start": "react-scripts start",
    "electron-wait": "wait-on http://localhost:3000 && electron .",
    "electron-dev": "electron .",
    "build": "cross-env INLINE_RUNTIME_CHUNK=false react-scripts build",
    "test": "node --test vault.test.js profiles.test.js src/utils/*.test.mjs",
    "eject": "react-scripts eject",
    "package": "electron-builder --win"
  },
  "build": {
    "extends": null,
    "appId": "com.cremacrem.kys",
    "productName": "KYS",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "main.js",
      "preload.js",
      "vault.js",
      "profiles.js",
      "src/utils/passwordStrength.mjs",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/KYS.ico"
    },
    "mac": {
      "icon": "assets/KYS.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/KYS.png"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "enableCookieEncryption": true,
      "grantFileProtocolExtraPrivileges": false
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.13",
    "wait-on": "^8.0.1"
  }
}
